# Copy to deploy/stellargate.env on the VM and fill in. That file is
# gitignored — it holds live secrets and must never be committed.
#
#   cp deploy/stellargate.env.example deploy/stellargate.env
#   chmod 600 deploy/stellargate.env
#
# Generate the two secrets with:  openssl rand -hex 32

# ── TLS / proxy (read by Caddy) ───────────────────────────────────────────
# Must already resolve to this VM's public IP, or certificate issuance fails.
DOMAIN=pay.example.com
ACME_EMAIL=you@example.com

# ── Stellar ───────────────────────────────────────────────────────────────
# Start on testnet and only switch once the flow is verified end to end.
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# For mainnet, change BOTH of the above together:
#   STELLAR_NETWORK=public
#   STELLAR_HORIZON_URL=https://horizon.stellar.org
# A network and Horizon URL that disagree will silently watch the wrong chain.

# The account to watch. Public key only — the gateway never holds a secret key.
STELLAR_GATEWAY_PUBLIC=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Assets to accept. Only native XLM may omit an issuer; every other asset is
# CODE:ISSUER. `ACCEPTED_ASSETS=XLM,USDC` (no issuer) is a boot failure.
# ACCEPTED_ASSETS=XLM,USDC:GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# ── Secrets — replace both, never reuse these placeholders ────────────────
# Minimum 32 characters. Boot fails on a known placeholder value.
WEBHOOK_SECRET=REPLACE_ME_generate_with_openssl_rand_hex_32
# Unset disables merchant provisioning entirely (POST /merchants always 401).
ADMIN_PROVISIONING_SECRET=REPLACE_ME_generate_with_openssl_rand_hex_32

# ── HTTP ──────────────────────────────────────────────────────────────────
# REQUIRED when STELLAR_NETWORK=public — boot fails without it.
CORS_ALLOWED_ORIGINS=https://yourapp.example.com

# Trusted proxies — comma-separated CIDR blocks whose X-Forwarded-For /
# X-Real-IP headers are honored for rate limiting and auth-log attribution.
# The headers are client-supplied and ignored unless the socket peer is one
# of these proxies; unset = headers always ignored (safe default). Caddy is
# the only proxy in front of the gateway here, so this usually stays unset.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8

# ── Operations ────────────────────────────────────────────────────────────
STELLAR_LISTENER_MODE=stream
RUST_LOG=stellargate=info,tower_http=warn
# Multiplier on POLL_INTERVAL_SECS that may elapse without a successful poll
# or stream event before /ready reports the detection cursor stale (503).
# Default 3; only needs tuning if your poll interval is very short and
# transient Horizon errors would otherwise flap the probe.
# CURSOR_STALENESS_MULTIPLE=3

# Leave false. Enabling it in production reopens the SSRF protection on
# webhook_url and lets a merchant point webhooks at your internal network.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
